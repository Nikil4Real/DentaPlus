# --- Supabase (used ONLY for clinic data storage, NOT auth) ---
# IMPORTANT: this must be the bare project URL, no /rest/v1/ suffix.
# Wrong:  https://xxxx.supabase.co/rest/v1/
# Right:  https://xxxx.supabase.co
VITE_SUPABASE_URL=https://qwkeengyypixpkovtmsm.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Supabase service role key (server-side only, source of truth for who can log in) ---
# Find this in Supabase Dashboard -> Project Settings -> API -> service_role key.
# NEVER put this in a VITE_ variable or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Gmail SMTP (sends the OTP email) ---
# GMAIL_APP_PASSWORD is a 16-character App Password from
# https://myaccount.google.com/apppasswords — NOT your normal Gmail password.
# Requires 2-Step Verification to be enabled on the Gmail account.
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# --- Session signing ---
# Any long random string. Generate one with: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_string

# --- Gemini (only if you use the AI features) ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
